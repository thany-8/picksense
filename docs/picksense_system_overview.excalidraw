      "boundElements": [],
      "updated": 1788051905499,
      "link": null,
      "locked": false,
      "text": "PickSense estimates how visually blocked an object is, and uses that\nocclusion level as a proxy for how easy the object would be to pick.\n\nTraining (lane 1) is done once and produces the .pth model file.\nThe web app (lane 2) only runs predictions — it never retrains.\n\nNote: it does NOT yet predict real robotic grasp success.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "PickSense estimates how visually blocked an object is, and uses that\nocclusion level as a proxy for how easy the object would be to pick.\n\nTraining (lane 1) is done once and produces the .pth model file.\nThe web app (lane 2) only runs predictions — it never retrains.\n\nNote: it does NOT yet predict real robotic grasp success.",
      "lineHeight": 1.25,
      "baseline": 11,
      "index": "aq",
      "autoResize": true
    }
  ],
